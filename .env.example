# Goodput configuration — copy to .env and edit locally.
# Never commit real secrets. All keys are documented here.

# --- Runtime ---
# cpu | cuda | mps (mps is Apple Silicon; cuda needs NVIDIA)
GOODPUT_DEVICE=cpu

# Number of simulated workers for local multi-process runs
GOODPUT_NUM_WORKERS=2
# Compose node id (ticket 2.4). Only rank 0 writes checkpoints on a shared volume.
# GOODPUT_RANK=0

# Random seed for reproducibility
GOODPUT_SEED=42

# --- Training (toy model) ---
GOODPUT_STEPS=100
GOODPUT_BATCH_SIZE=8
# Feature dimension for synthetic Gaussian batches
GOODPUT_INPUT_SIZE=16
GOODPUT_HIDDEN_SIZE=32
GOODPUT_LEARNING_RATE=1e-3

# --- Checkpointing ---
# Steps between checkpoints (0 = disabled)
GOODPUT_CKPT_INTERVAL=10
# naive = full state dump every time; incremental = model-only between full bases (ticket 2.1)
GOODPUT_CKPT_MODE=naive
# How often incremental mode writes a full model+optimizer base
GOODPUT_CKPT_FULL_EVERY=4
GOODPUT_CKPT_DIR=artifacts/checkpoints

# --- Fault injection ---
# none | kill | hang | bitflip
GOODPUT_FAULT_MODE=none
# Step at which to inject (or "random")
GOODPUT_FAULT_AT=random
# Mean steps between failures when using a schedule (0 = single shot)
GOODPUT_FAULT_MEAN_INTERVAL=0

# --- Metrics / artifacts ---
GOODPUT_ARTIFACTS_DIR=artifacts
GOODPUT_RUN_NAME=local-dev
# json | csv | both
GOODPUT_REPORT_FORMAT=json

# --- Providers (swappable backends) ---
# mock | local_fs  (CI forces mock when GOODPUT_CI_MODE=1)
GOODPUT_CHECKPOINT_PROVIDER=local_fs
# mock | process  (process dry-runs in CI; real SIGKILL is ticket 1.6)
GOODPUT_FAULT_PROVIDER=mock
# json_file | stdout | mock
GOODPUT_METRICS_PROVIDER=json_file

# --- Experiment tracking (optional; stub until Phase 3) ---
# none | mlflow | wandb
GOODPUT_TRACKER=none
# GOODPUT_WANDB_PROJECT=
# GOODPUT_MLFLOW_TRACKING_URI=

# --- CI / tests ---
GOODPUT_CI_MODE=0
